# ========================================================
# ROBOLAB CHAIN - FRONTEND ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env.local and fill in your real blockchain details:
# cp .env.example .env.local

# --------------------------------------------------------
# 1. MST BLOCKCHAIN / EVM NETWORK CONFIGURATION
# --------------------------------------------------------
# JSON-RPC endpoint for your MST node or testnet
NEXT_PUBLIC_MST_RPC_URL="https://rpc.testnet.mst.com"

# Network Chain ID (e.g. 1001 for MST Testnet, or 1337 / 31337 for local Hardhat)
NEXT_PUBLIC_MST_CHAIN_ID=1001

# Network name displayed across certificates & verifier badges
NEXT_PUBLIC_MST_NETWORK_NAME="MST Testnet (Chain ID: 1001)"

# --------------------------------------------------------
# 2. DEPLOYED SMART CONTRACT ADDRESSES
# --------------------------------------------------------
# Address of the deployed RobotEventLedger / Certificate Attestation contract
NEXT_PUBLIC_CONTRACT_ROBOT_EVENT_LEDGER="0x92A138402f1a4e5122189d21c900e527182981FD"

# Address of the deployed RobotRegistry contract
NEXT_PUBLIC_CONTRACT_ROBOT_REGISTRY="0x71A4B82F09a89CD1842b0129384910248102919"

# --------------------------------------------------------
# 3. BLOCK EXPLORER
# --------------------------------------------------------
# Base URL for transaction & block lookup (MSTScan)
NEXT_PUBLIC_BLOCK_EXPLORER_URL="https://scan.testnet.mst.com"

# --------------------------------------------------------
# 4. BACKEND API SERVICE
# --------------------------------------------------------
# FastAPI backend endpoint
NEXT_PUBLIC_API_URL="http://localhost:8000"
