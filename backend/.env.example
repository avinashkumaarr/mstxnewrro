APP_NAME="RoboLedger API"
APP_VERSION="1.0.0"
DEBUG=True

DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/roboledger"

SECRET_KEY="replace-this-with-a-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

BLOCKCHAIN_ENABLED=False
MST_RPC_URL="https://rpc.testnet.mst.com" # Replace with actual MST Testnet RPC
MST_CHAIN_ID=1001 # Replace with actual Chain ID
MST_CONTRACT_ROBOT_REGISTRY="0x0000000000000000000000000000000000000000"
MST_CONTRACT_ROBOT_EVENT_LEDGER="0x0000000000000000000000000000000000000000"
MST_SIGNER_PRIVATE_KEY="" # NEVER COMMIT REAL PRIVATE KEYS
