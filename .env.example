# ==============================================================================
# ROBOLAB CHAIN — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file or the respective folder-level .env.example files to configure:
#   - frontend/.env.local (Client-side Next.js configuration)
#   - backend/.env        (FastAPI backend configuration)
#   - web3/.env           (Hardhat smart contract deployment configuration)
#
# IMPORTANT:
# - NEVER commit real private keys, passwords, or secret tokens to version control.
# - All variables prefixed with NEXT_PUBLIC_ are exposed to the browser client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (frontend/.env.local)
# ------------------------------------------------------------------------------
# MST Testnet JSON-RPC Endpoint (Chain ID: 91562037)
NEXT_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com

# MST Testnet Chain ID (91562037 / 0x5748805)
NEXT_PUBLIC_MST_CHAIN_ID=91562037

# Display name for the connected network
NEXT_PUBLIC_MST_NETWORK_NAME="MST Testnet (Chain ID: 91562037)"

# Deployed Attestation & Event Ledger Contract Address on MST Testnet
NEXT_PUBLIC_CONTRACT_ROBOT_EVENT_LEDGER=0xFf28A7c0524Be166b96aB215eE24Df3E939E9eEC

# Deployed Robot Identity Registry Contract Address on MST Testnet
NEXT_PUBLIC_CONTRACT_ROBOT_REGISTRY=0x0E570aC03b653A453051F10b949eB4673E914348

# Block Explorer URL for transaction and block validation
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.mstscan.com

# Backend FastAPI REST & WebSocket endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Clerk Authentication (if running outside development keyless mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------
APP_NAME="RoboLedger API"
APP_VERSION="1.0.0"
DEBUG=True

# Database connection URL (PostgreSQL or local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./roboledger.db

# JWT & Application Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Blockchain Relayer / Attestation Authority Settings
BLOCKCHAIN_ENABLED=False
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_CONTRACT_ROBOT_REGISTRY=0x0E570aC03b653A453051F10b949eB4673E914348
MST_CONTRACT_ROBOT_EVENT_LEDGER=0xFf28A7c0524Be166b96aB215eE24Df3E939E9eEC
MST_SIGNER_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 3. WEB3 / SMART CONTRACTS ENVIRONMENT VARIABLES (web3/.env)
# ------------------------------------------------------------------------------
# Hardhat deployment network settings
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037

# Deployer wallet private key for Hardhat deployment scripts (DO NOT COMMIT REAL KEY)
DEPLOYER_PRIVATE_KEY=
